# Compass, Testbetrieb. Solange die Inhalte nicht geprüft sind, soll nichts
# davon in einer Suchmaschine stehen — auch die JSON- und Audiodateien nicht,
# deshalb als Header und nicht nur als Meta-Tag.

<IfModule mod_headers.c>
  Header set X-Robots-Tag "noindex, nofollow"
</IfModule>

Options -Indexes

# Die Datendateien holt der Service Worker bei jedem Besuch im Hintergrund neu.
# Mit einem Browser-Cache davor käme eine korrigierte Telefonnummer trotzdem
# erst Tage später an.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html        "access plus 0 seconds"
  ExpiresByType application/json "access plus 0 seconds"
</IfModule>
